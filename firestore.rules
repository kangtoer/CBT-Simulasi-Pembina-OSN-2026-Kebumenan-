rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    
    // Improved isAdmin check: check existence before role lookup to avoid crashes
    function isAdmin() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; 
    }
    
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    
    // User Rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Allow creation if the user is authenticated and creating their own profile
      allow create: if isSignedIn() && userId == request.auth.uid; 
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']));
    }

    // Health check rule
    match /test/connection {
      allow read: if true;
    }

    // Exam Rules
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Question Rules
    match /exams/{examId}/questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Result Rules
    match /results/{resultId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'started';

      allow update: if isSignedIn() && 
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'started' &&
        (
          // Allow updating answers while started
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['answers', 'status', 'endTime', 'score', 'totalCorrect', 'totalQuestions'])
        );
      
      allow delete: if isAdmin();
    }
  }
}
